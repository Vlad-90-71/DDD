{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Db/smart_enum.db"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "ddd",
    "Password": "local-rabbitmq-change-me",
    "VirtualHost": "/",
    "Exchange": "ddd.events",
    "Queue": "ddd.events.queue",
    "RoutingKey": "ddd.events",
    "RetryExchange": "ddd.events.retry",
    "RetryQueue": "ddd.events.retry.queue",
    "RetryRoutingKey": "ddd.events.retry",
    "RetryDelayMilliseconds": 5000,
    "MaxRetryCount": 3,
    "DeadLetterExchange": "ddd.events.dlx",
    "DeadLetterQueue": "ddd.events.dlq",
    "DeadLetterRoutingKey": "ddd.events.dlq"
  }
}
